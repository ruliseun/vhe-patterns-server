<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= subject %></title>
  </head>
  <body style="margin:0;padding:0;background-color:#f6f4f3;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f4f3;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background-color:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #efe7e4;">
            <tr>
              <td style="background-color:#1a1a1a;padding:24px 32px;">
                <span style="color:#ffffff;font-size:18px;font-weight:600;letter-spacing:0.3px;">VhePatterns</span>
                <span style="color:#f4a8a0;font-size:12px;display:block;margin-top:4px;letter-spacing:1.5px;text-transform:uppercase;">Custom print update</span>
              </td>
            </tr>
            <tr>
              <td style="padding:28px 32px 0;">
                <span style="display:inline-block;background-color:<%= accent %>;color:#ffffff;font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;border-radius:999px;padding:5px 12px;"><%= heading %></span>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px 0;">
                <p style="margin:0;color:#1a1a1a;font-size:15px;">Hi <%= firstName %>,</p>
              </td>
            </tr>
            <tr>
              <td style="padding:12px 32px 8px;">
                <p style="margin:0;color:#474747;font-size:14px;line-height:1.8;"><%= body %></p>
              </td>
            </tr>
            <% if (note) { %>
            <tr>
              <td style="padding:12px 32px 8px;">
                <p style="margin:0 0 8px;color:#8a8a8a;font-size:12px;text-transform:uppercase;letter-spacing:0.8px;">A note from our team</p>
                <div style="background-color:#faf8f7;border-left:3px solid <%= accent %>;border-radius:6px;padding:14px 16px;color:#474747;font-size:14px;line-height:1.7;white-space:pre-line;"><%= note %></div>
              </td>
            </tr>
            <% } %>
            <tr>
              <td style="padding:16px 32px 8px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #f0eeec;border-radius:10px;">
                  <tr>
                    <td style="padding:12px 16px;color:#8a8a8a;font-size:12px;text-transform:uppercase;letter-spacing:0.8px;width:120px;">Request</td>
                    <td style="padding:12px 16px;color:#1a1a1a;font-size:14px;"><%= service %></td>
                  </tr>
                  <tr>
                    <td style="padding:12px 16px;border-top:1px solid #f0eeec;color:#8a8a8a;font-size:12px;text-transform:uppercase;letter-spacing:0.8px;">Quantity</td>
                    <td style="padding:12px 16px;border-top:1px solid #f0eeec;color:#1a1a1a;font-size:14px;"><%= quantity %></td>
                  </tr>
                  <tr>
                    <td style="padding:12px 16px;border-top:1px solid #f0eeec;color:#8a8a8a;font-size:12px;text-transform:uppercase;letter-spacing:0.8px;">Submitted</td>
                    <td style="padding:12px 16px;border-top:1px solid #f0eeec;color:#1a1a1a;font-size:14px;"><%= submittedAt %></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px 28px;">
                <p style="margin:0;color:#474747;font-size:14px;line-height:1.7;">
                  Warm regards,<br />
                  <span style="color:#1a1a1a;font-weight:600;">The VhePatterns Team</span>
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px;background-color:#faf8f7;border-top:1px solid #f0eeec;">
                <p style="margin:0;color:#ababab;font-size:11px;line-height:1.6;">
                  You're receiving this because you requested a custom print on our website. Questions? Reach us at
                  <a href="mailto:support@vhepatterns.com" style="color:#e2604f;text-decoration:none;">support@vhepatterns.com</a>.
                </p>
              </td>
            </tr>
          </table>
          <p style="margin:16px 0 0;color:#ababab;font-size:11px;text-align:center;">
            VhePatterns — Home of Unique Creative Designs
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
