<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Email</title>
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;600;700;900&display=swap" rel="stylesheet">

  <style>
    * {
      font-family: 'Lato', Arial, sans-serif !important;
    }

    a {
      text-decoration: none;
    }
  </style>
</head>

<body style="margin:0; padding:0; font-family:'Lato', Arial, sans-serif; background-color:#F3F4F6;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding:40px 0;">
    <tr>
      <td align="center">

        <table width="650" cellpadding="0" cellspacing="0" border="0"
          style="background-color:#FCFCFC; border-radius:8px; overflow:hidden;">

          <%- include('internal-header.ejs') %>

            <tr>
              <td style="padding:0 60px 60px 60px;">

                <table cellpadding="0" cellspacing="0" border="0" width="100%">

                  <tr>
                    <td style="font-size:28px; font-weight:700; color:#111827; padding-bottom:24px; line-height:1.2;">
                      Almost There! Confirm Your Email
                    </td>
                  </tr>

                  <tr>
                    <td style="font-size:16px; color:#374151; line-height:1.6; padding-bottom:32px;">
                      Hello <%= user_name %>,
                    </td>
                  </tr>

                  <tr>
                    <td style="font-size:16px; color:#374151; line-height:1.6; padding-bottom:32px;">
                      Welcome to <span style="font-weight:600; color:#111827;"><%= organisationName %></span>. Before you can access your account and connect with our community, we just need to confirm your email address.
                    </td>
                  </tr>

                  <tr>
                    <td align="center" style="padding-bottom:32px;">
                      <table cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td align="center" style="background-color:#2563EB; border-radius:8px; padding:14px 32px;">
                            <a href="<%= verification_link %>"
                              style="font-size:16px; font-weight:600; color:#ffffff; text-decoration:none; display:block;">
                              Verify Email Address
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <tr>
                    <td style="padding-bottom:32px;">
                      <table cellpadding="0" cellspacing="0" border="0" width="100%"
                        style="background-color:#F0F5FF; border-radius:12px; padding:24px;">
                        <tr>
                          <td valign="top" width="32">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                              xmlns="http://www.w3.org/2000/svg">
                              <circle cx="12" cy="12" r="10" fill="#2563EB" />
                              <path d="M12 7V13" stroke="white" stroke-width="2" stroke-linecap="round" />
                              <circle cx="12" cy="16.5" r="1" fill="white" />
                            </svg>
                          </td>
                          <td width="16"></td>
                          <td style="font-size:14px; color:#1E3A8A; line-height:1.6;">
                            If you did not register for <span style="font-weight:600;"><%= organisationName %></span>, you can safely ignore this email.
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <tr>
                    <td style="font-size:16px; color:#374151; padding-bottom:8px;">
                      With love 💙,
                    </td>
                  </tr>
                  <tr>
                    <td style="font-size:16px; color:#374151; padding-bottom:32px;">
                      <%= organisationName %>
                    </td>
                  </tr>

                  <tr>
                    <td style="padding-bottom:24px;">
                      <table cellpadding="0" cellspacing="0" border="0" width="100%">
                        <tr>
                          <td style="border-top:1px solid #E5E7EB;"></td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <tr>
                    <td style="font-size:14px; color:#6B7280; line-height:1.6; text-align:center;">
                      Click the button above to verify your email and get started with your account.
                    </td>
                  </tr>

                </table>

              </td>
            </tr>

            <%- include('internal-footer.ejs') %>

        </table>

      </td>
    </tr>
  </table>

</body>

</html>